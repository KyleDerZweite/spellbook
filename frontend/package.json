{
	"name": "spellbook-frontend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test:unit": "vitest run --project unit",
		"test:integration": "vitest run --project integration",
		"lint": "svelte-kit sync && prettier --check . && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:check": "drizzle-kit check"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1121.0",
		"bits-ui": "^2.19.0",
		"drizzle-orm": "^0.45.2",
		"jose": "^6.2.10",
		"mana-font": "^1.18.0",
		"meilisearch": "^0.60.0",
		"pg": "^8.23.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.4.0",
		"@types/pg": "^8.23.1",
		"csstype": "^3.2.3",
		"drizzle-kit": "^0.31.10",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.11"
	},
	"pnpm": {
		"overrides": {
			"cookie": "0.7.2"
		}
	}
}
