{
	"name": "spellbook-frontend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node --env-file-if-exists=../.env node_modules/vite/bin/vite.js dev",
		"dev:local": "node --env-file-if-exists=../.env scripts/dev.mjs",
		"test:dev": "node --test scripts/dev.test.mjs",
		"build": "vite build && node ../scripts/check-client.mjs && node --test tests/pwa-worker.test.ts",
		"preview": "vite preview",
		"check": "svelte-kit sync && pnpm check:ts && svelte-check --tsconfig ./tsconfig.json",
		"test:unit": "vitest run --project unit",
		"test:integration": "vitest run --project integration",
		"test:performance": "vitest run --project performance",
		"lint": "pnpm --dir .. check:boundaries && pnpm --dir .. test:boundaries && prettier --config .prettierrc --check . ../backend ../contracts ../scripts ../package.json && pnpm check",
		"format": "prettier --write .",
		"db:generate": "node --env-file-if-exists=../.env node_modules/drizzle-kit/bin.cjs generate",
		"db:migrate": "node --env-file-if-exists=../.env node_modules/drizzle-kit/bin.cjs migrate",
		"db:check": "node --env-file-if-exists=../.env node_modules/drizzle-kit/bin.cjs check",
		"check:ts": "node node_modules/typescript-native/bin/tsc --noEmit && node node_modules/typescript-native/bin/tsc --noEmit -p src/service-worker/tsconfig.json",
		"demo:seed": "node --env-file-if-exists=../.env scripts/demo/seed.mjs",
		"dev:demo": "pnpm demo:seed && DEMO_MODE=true pnpm dev",
		"test:http": "node --test --test-concurrency=1 tests/http-runtime.test.ts tests/http-application.test.ts tests/categories-http.test.ts tests/category-library-http.test.ts tests/deck-choices-http.test.ts tests/deck-refresh-http.test.ts tests/value-history-http.test.ts tests/whole-deck-http.test.ts tests/combo-http.test.ts tests/qr-auth-http.test.ts",
		"test:sync": "node --test tests/saved-state-http.test.ts",
		"test:scan": "node --test tests/scan-http.test.ts"
	},
	"dependencies": {
		"@spellbook/backend": "workspace:*",
		"@spellbook/contracts": "workspace:*",
		"@zxing/browser": "^0.2.1",
		"bits-ui": "^2.19.5",
		"drizzle-orm": "^0.45.4",
		"mana-font": "^1.18.0",
		"pg": "^8.23.1",
		"qrcode": "^1.5.4"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.4",
		"@types/pg": "^8.23.1",
		"@types/qrcode": "^1.5.6",
		"csstype": "^3.2.3",
		"drizzle-kit": "^0.31.11",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-native": "npm:typescript@^7.0.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.3"
	},
	"packageManager": "pnpm@12.8.1",
	"engines": {
		"node": ">=26 <27",
		"pnpm": "12.8.1"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
