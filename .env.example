# MeiliSearch
MEILI_MASTER_KEY=change-me-to-a-secure-key

# Postgres
POSTGRES_DB=spellbook
POSTGRES_USER=spellbook
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://spellbook:change-me@localhost:5432/spellbook

# Data Pipeline
AGGRESSIVE_PRELOAD=true
SYNC_INTERVAL=daily
LANGUAGES=en
WORKER_DATA_DIR=/app/data

# Frontend auth and app origin
OIDC_ISSUER=https://auth.yourdomain.com
OIDC_CLIENT_ID=change-me-to-your-oidc-client-id
OIDC_MOBILE_CLIENT_ID=
APP_ORIGIN=https://spellbook.yourdomain.com
AUTH_SESSION_SECRET=replace-with-32-byte-base64url-secret

# Frontend (browser-facing)
PUBLIC_MEILISEARCH_URL=https://spellbook-search.yourdomain.com

# Scan artifact storage
SCAN_STORAGE_DRIVER=s3

# Production scan artifact storage (required when SCAN_STORAGE_DRIVER=s3)
S3_ENDPOINT=https://s3.yourdomain.com
S3_REGION=us-east-1
S3_BUCKET=spellbook-scans
S3_ACCESS_KEY_ID=change-me-to-an-access-key
S3_SECRET_ACCESS_KEY=change-me-to-a-secret-key
S3_FORCE_PATH_STYLE=true

# Pangolin / Newt (tunnel agent)
PANGOLIN_ENDPOINT=https://pangolin.example.com
NEWT_ID=change-me
NEWT_SECRET=change-me
