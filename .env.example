# Native process configuration. Container deployments use the prefixed sections below.
# Postgres
POSTGRES_DB=spellbook
POSTGRES_USER=spellbook
POSTGRES_PASSWORD=change-me
# Native tools use this URL. Configured Compose uses the selected prefixed POSTGRES_* keys.
DATABASE_URL=postgres://spellbook:change-me@localhost:5432/spellbook

# Native operator and API commands. Compose supplies its own private addresses.
API_HOST=127.0.0.1
API_PORT=3001
API_INTERNAL_URL=http://127.0.0.1:3001
API_TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1
SCAN_LOCAL_STORAGE_DIR=

# Data Pipeline
CATALOG_SOURCE=all_cards
SYNC_INTERVAL=daily
# Optional public feeds, no accounts or API keys.
CARDMARKET_PRICES_ENABLED=false
MTGJSON_PRICES_ENABLED=false
# Native launchers resolve relative paths from the repository root; Compose uses /app/data.
WORKER_DATA_DIR=.local/catalog

# Optional public price import bounds. These values are the native defaults.
# Byte limits are bytes; deadlines are seconds. Overrides must be positive integers.
PRICE_COMPRESSED_BYTES=536870912
PRICE_DECOMPRESSED_BYTES=8589934592
PRICE_RECORD_BYTES=2097152
PRICE_PROGRESS_SECONDS=30
PRICE_CONNECT_SECONDS=10
PRICE_DOWNLOAD_SECONDS=600
PRICE_PARSE_SECONDS=600
PRICE_PUBLICATION_SECONDS=600
PRICE_IMPORT_SECONDS=1800
PRICE_STAGING_BYTES=12884901888

# Public frontend origin, embedded at build time. Rebuild after changing it.
APP_ORIGIN=https://spellbook.yourdomain.com

# Leave empty for direct connections. Behind a trusted proxy that overwrites the
# client IP header, set ADDRESS_HEADER=x-forwarded-for and the trusted hop count.
ADDRESS_HEADER=
XFF_DEPTH=1

# Adapter request limit, including multipart overhead. Scan images allow 10 MiB.
BODY_SIZE_LIMIT=12M


# Optional throwaway Jev evaluation only. Not consumed by the application or Compose.
# Keep the real value in the ignored .env, never in browser code.
TYPESAFE_API_KEY=

# Personal Inventory observation runner and reporting calendar
VALUE_HISTORY_ENABLED=true
VALUE_HISTORY_TIMEZONE=Europe/Berlin

# Optional development-only search evaluation. Never point these at application data.
# Assign disposable loopback databases named spellbook_search_eval_<run>.
SEARCH_EVALUATION_URL=
SEARCH_EVALUATION_DATABASE_URL=
SEARCH_EVALUATION_BM25_URL=

# Exactly three Compose files: compose.yml standalone, compose.dev.yml private Development,
# compose.prod.yml hosted Production/Demo/site through pnpm compose.
# HOSTED_* variables are internal launcher output; do not set them here.
# Production Compose and permanent server connector. Keep Production stopped until selected.
# Full selected Git SHA for immutable images. Required before build/up/run.
PROD_IMAGE_REVISION=
PROD_APP_ORIGIN=https://spellbook.example.com
PROD_POSTGRES_DB=spellbook
PROD_POSTGRES_USER=spellbook
PROD_POSTGRES_PASSWORD=replace-with-a-private-production-password
PROD_PANGOLIN_ENDPOINT=https://pangolin.example.com
PROD_NEWT_ID=replace-with-server-site-id
PROD_NEWT_SECRET=replace-with-server-site-secret
PROD_INGRESS_NETWORK=spellbook-prod-ingress
PROD_FRONTEND_ALIAS=spellbook-production-web

# Hosted Demo. Its server connector uses PROD_* above.
DEMO_IMAGE_REVISION=
DEMO_APP_ORIGIN=https://spellbook-demo.example.com
DEMO_POSTGRES_DB=spellbook_demo
DEMO_POSTGRES_USER=spellbook
DEMO_POSTGRES_PASSWORD=replace-with-a-private-demo-password
DEMO_FRONTEND_ALIAS=spellbook-demo-web

# Configured Development Compose and its own connector.
# Without a root .env, pnpm dev uses localhost without Newt.
# Set DEV_LOCAL_PORT in the shell to change that local port, default 3000.
DEV_APP_ORIGIN=https://spellbook-dev.example.com
DEV_POSTGRES_DB=spellbook_dev
DEV_POSTGRES_USER=spellbook
DEV_POSTGRES_PASSWORD=replace-with-a-private-development-password
DEV_PANGOLIN_ENDPOINT=https://pangolin.example.com
DEV_NEWT_ID=replace-with-development-site-id
DEV_NEWT_SECRET=replace-with-development-site-secret

# Optional PROD overrides. Empty values use the selected mode defaults.
PROD_VALUE_HISTORY_ENABLED=
PROD_VALUE_HISTORY_TIMEZONE=
PROD_ADDRESS_HEADER=
PROD_XFF_DEPTH=
PROD_BODY_SIZE_LIMIT=
PROD_CATALOG_SOURCE=
PROD_SYNC_INTERVAL=
PROD_CARDMARKET_PRICES_ENABLED=
PROD_MTGJSON_PRICES_ENABLED=
PROD_PRICE_COMPRESSED_BYTES=
PROD_PRICE_DECOMPRESSED_BYTES=
PROD_PRICE_RECORD_BYTES=
PROD_PRICE_PROGRESS_SECONDS=
PROD_PRICE_CONNECT_SECONDS=
PROD_PRICE_DOWNLOAD_SECONDS=
PROD_PRICE_PARSE_SECONDS=
PROD_PRICE_PUBLICATION_SECONDS=
PROD_PRICE_IMPORT_SECONDS=
PROD_PRICE_STAGING_BYTES=

# Optional DEMO overrides. Storage stays local; Catalog stays all_cards/manual.
# Empty values use the selected mode defaults.
DEMO_VALUE_HISTORY_ENABLED=
DEMO_VALUE_HISTORY_TIMEZONE=
DEMO_ADDRESS_HEADER=
DEMO_XFF_DEPTH=
DEMO_BODY_SIZE_LIMIT=
DEMO_CARDMARKET_PRICES_ENABLED=
DEMO_MTGJSON_PRICES_ENABLED=
DEMO_PRICE_COMPRESSED_BYTES=
DEMO_PRICE_DECOMPRESSED_BYTES=
DEMO_PRICE_RECORD_BYTES=
DEMO_PRICE_PROGRESS_SECONDS=
DEMO_PRICE_CONNECT_SECONDS=
DEMO_PRICE_DOWNLOAD_SECONDS=
DEMO_PRICE_PARSE_SECONDS=
DEMO_PRICE_PUBLICATION_SECONDS=
DEMO_PRICE_IMPORT_SECONDS=
DEMO_PRICE_STAGING_BYTES=

# Optional configured Development settings.
DEV_ADDRESS_HEADER=
DEV_BODY_SIZE_LIMIT=
DEV_VALUE_HISTORY_ENABLED=
DEV_VALUE_HISTORY_TIMEZONE=
DEV_XFF_DEPTH=

# Optional LOCAL settings. Standalone LOCAL settings need no .env by default.
LOCAL_ADDRESS_HEADER=
LOCAL_APP_ORIGIN=
LOCAL_BODY_SIZE_LIMIT=
LOCAL_PORT=
LOCAL_POSTGRES_DB=
LOCAL_POSTGRES_USER=
LOCAL_VALUE_HISTORY_ENABLED=
LOCAL_VALUE_HISTORY_TIMEZONE=
LOCAL_XFF_DEPTH=
