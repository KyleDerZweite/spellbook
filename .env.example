# Postgres
POSTGRES_DB=spellbook
POSTGRES_USER=spellbook
POSTGRES_PASSWORD=change-me
# Native tools use this URL. Compose builds its internal URL from POSTGRES_*.
DATABASE_URL=postgres://spellbook:change-me@localhost:5432/spellbook

# Native operator and API commands. Compose supplies its own private addresses.
API_HOST=127.0.0.1
API_PORT=3001
API_INTERNAL_URL=http://127.0.0.1:3001
API_TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1
SCAN_LOCAL_STORAGE_DIR=

# Data Pipeline
CATALOG_SOURCE=all_cards
SYNC_INTERVAL=daily
# Optional public feeds, no accounts or API keys.
CARDMARKET_PRICES_ENABLED=false
MTGJSON_PRICES_ENABLED=false
# Native launchers resolve relative paths from the repository root; Compose uses /app/data.
WORKER_DATA_DIR=.local/catalog

# Optional public price import bounds. These values are the native defaults.
# Byte limits are bytes; deadlines are seconds. Overrides must be positive integers.
PRICE_COMPRESSED_BYTES=536870912
PRICE_DECOMPRESSED_BYTES=8589934592
PRICE_RECORD_BYTES=2097152
PRICE_PROGRESS_SECONDS=30
PRICE_CONNECT_SECONDS=10
PRICE_DOWNLOAD_SECONDS=600
PRICE_PARSE_SECONDS=600
PRICE_PUBLICATION_SECONDS=600
PRICE_IMPORT_SECONDS=1800
PRICE_STAGING_BYTES=12884901888

# Public frontend origin, embedded at build time. Rebuild after changing it.
APP_ORIGIN=https://spellbook.yourdomain.com

# Leave empty for direct connections. Behind a trusted proxy that overwrites the
# client IP header, set ADDRESS_HEADER=x-forwarded-for and the trusted hop count.
ADDRESS_HEADER=
XFF_DEPTH=1

# Adapter request limit, including multipart overhead. Scan images allow 10 MiB.
BODY_SIZE_LIMIT=12M

# Scan artifact storage
SCAN_STORAGE_DRIVER=s3

# Production scan artifact storage (required when SCAN_STORAGE_DRIVER=s3)
S3_ENDPOINT=https://s3.yourdomain.com
S3_REGION=us-east-1
S3_BUCKET=spellbook-scans
S3_ACCESS_KEY_ID=change-me-to-an-access-key
S3_SECRET_ACCESS_KEY=change-me-to-a-secret-key
S3_FORCE_PATH_STYLE=true

# Optional Pangolin / Newt tunnel, enabled with --profile tunnel
PANGOLIN_ENDPOINT=https://pangolin.example.com
NEWT_ID=change-me
NEWT_SECRET=change-me

# Optional throwaway Jev evaluation only. Not consumed by the application or Compose.
# Keep the real value in the ignored .env, never in browser code.
TYPESAFE_API_KEY=

# Personal Inventory observation runner and reporting calendar
VALUE_HISTORY_ENABLED=true
VALUE_HISTORY_TIMEZONE=Europe/Berlin

# Optional development-only search evaluation. Never point these at application data.
# Assign disposable loopback databases named spellbook_search_eval_<run>.
SEARCH_EVALUATION_URL=
SEARCH_EVALUATION_DATABASE_URL=
SEARCH_EVALUATION_BM25_URL=
